{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {"type": "none"},
  "display": {"separator": "", "pipe": false, "showErrors": true},
  "modules": [
    // Native Fastfetch command modules. Commas join rows; spaces separate columns.
    // Change Time=... labels here, reorder metrics, or replace with native modules.
    {
      "type": "command", "key": " ", "format": "{result}",
      "text": "\"$LIVEPANEL_PYTHON\" \"$LIVEPANEL_APP/render.py\" columns 'Time=time,Uptime=uptime,OS Age=age,Odometer=odometer,Average=average' 'CPU=cpu,GPU=gpu,RAM=memory,VRAM=vram,Swap=swap' 'Download=down,Upload=up,Local IP=ip,Date=date,Processes=processes'"
    },
    "break",
    {
      "type": "command", "key": " ", "format": "{result}",
      "text": "\"$LIVEPANEL_PYTHON\" \"$LIVEPANEL_APP/render.py\" rows playing weather forecast"
    }
  ]
}
